# Copy this file to .env.local and fill in the values for local development.
# .env.local is gitignored and must never be committed.

# Base URL of the Cloudflare Worker API.
# For local development, Wrangler runs on port 8787 by default.
# For production, set this to your deployed Worker URL, e.g.:
#   https://community-platform-os-worker.<your-subdomain>.workers.dev
# or your custom domain:
#   https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8787
