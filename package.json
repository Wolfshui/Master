    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/node": "22.13.14",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "eslint": "9.22.0",
    "miniflare": "3.20231030.0",
    "prettier": "3.5.3",
    "turbo": "2.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.26.1",
    "vitest": "3.1.1",
    "wrangler": "4.31.0"
  }
