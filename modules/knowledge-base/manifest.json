{
  "schemaVersion": "1.0.0",
  "id": "knowledge-base",
  "name": "Knowledge Base",
  "version": "0.1.0",
  "description": "Knowledge base module that adds article CRUD, publication events, and operational help content.",
  "entrypoint": "./src/index.ts",
  "compatibility": {
    "platform": "cloudflare-workers",
    "sdk": "0.1.0",
    "minimumCoreVersion": "0.1.0",
    "testedCoreVersions": [
      "0.1.0"
    ]
  },
  "permissions": [
    {
      "key": "knowledge-base.article.read",
      "resource": "knowledge-base.article",
      "action": "read",
      "description": "Read knowledge base articles",
      "assignable": true
    },
    {
      "key": "knowledge-base.article.write",
      "resource": "knowledge-base.article",
      "action": "update",
      "description": "Create and edit knowledge base articles",
      "assignable": true
    },
    {
      "key": "knowledge-base.article.publish",
      "resource": "knowledge-base.article",
      "action": "publish",
      "description": "Publish knowledge base articles",
      "assignable": true
    },
    {
      "key": "knowledge-base.article.manage",
      "resource": "knowledge-base.article",
      "action": "manage",
      "description": "Archive or delete knowledge base articles",
      "assignable": false
    }
  ],
  "routes": [
    {
      "path": "/kb/articles",
      "method": "GET",
      "handler": "listArticles",
      "permission": "knowledge-base.article.read",
      "public": false
    },
    {
      "path": "/kb/articles",
      "method": "POST",
      "handler": "createArticle",
      "permission": "knowledge-base.article.write",
      "public": false
    },
    {
      "path": "/kb/articles/:id",
      "method": "GET",
      "handler": "getArticle",
      "permission": "knowledge-base.article.read",
      "public": false
    },
    {
      "path": "/kb/articles/:id",
      "method": "PUT",
      "handler": "updateArticle",
      "permission": "knowledge-base.article.write",
      "public": false
    },
    {
      "path": "/kb/articles/:id",
      "method": "DELETE",
      "handler": "deleteArticle",
      "permission": "knowledge-base.article.manage",
      "public": false
    }
  ],
  "lifecycle": {
    "validate": "validate",
    "install": "install",
    "activate": "activate",
    "deactivate": "deactivate",
    "update": "update",
    "rollback": "rollback",
    "uninstall": "uninstall",
    "purge": "purge"
  },
  "assets": {
    "package": "r2://packages/knowledge-base-0.1.0.tgz",
    "integrity": "sha256-knowledgebasepackage",
    "icon": "r2://packages/knowledge-base-icon.svg"
  },
  "events": {
    "publishes": [
      "knowledge-base.article.created.v1",
      "knowledge-base.article.updated.v1",
      "knowledge-base.article.deleted.v1"
    ],
    "subscribes": []
  },
  "settings": {
    "sections": [
      {
        "key": "general",
        "title": "General",
        "description": "Knowledge-base defaults and discoverability.",
        "fields": [
          {
            "key": "knowledge-base.defaultLocale",
            "label": "Default locale",
            "type": "text",
            "required": true,
            "defaultValue": "en"
          },
          {
            "key": "knowledge-base.defaultCategory",
            "label": "Default category",
            "type": "text",
            "required": false,
            "defaultValue": "general"
          }
        ]
      }
    ]
  },
  "billing": {
    "required": false,
    "purchaseType": "free",
    "sku": "kb-free"
  },
  "support": {
    "url": "https://community-os.dev/modules/knowledge-base",
    "contactEmail": "support@community-os.dev"
  }
}
