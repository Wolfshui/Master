
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@community-os/core-types": ["./packages/core-types/src/index.ts"],
      "@community-os/module-sdk": ["./packages/module-sdk/src/index.ts"],
      "@community-os/module-knowledge-base": ["./modules/knowledge-base/src/index.ts"]
    }
  }
}
